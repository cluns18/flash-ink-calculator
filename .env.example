# Firebase web config (artwork uploads). Client-side, safe to ship; values are the shared
# obg-calculator project, see reference_firebase_calc_config. Keep real values in .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Shared OBG garment catalog (read-only). Powers "Explore all options". Without these the
# calculator still runs on Flash Ink's curated styles in src/garments/.
VITE_SUPABASE_URL=https://ydwzfnawueliuvywedla.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional override of the quote endpoint (default https://obg-mail-api.vercel.app/api/send_quote).
# VITE_QUOTE_ENDPOINT=

# Analytics (build-time). No-ops until set.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
